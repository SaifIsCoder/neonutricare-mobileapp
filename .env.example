# NeoNutriCare — environment template
# Copy to .env and fill in real values. .env is git-ignored.
#
# Use the PUBLISHABLE (anon) key, never the secret / service-role key —
# the service-role key bypasses Row Level Security and must never ship
# in a client bundle.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# FastAPI prediction service (TASKS Phase 6). Leave blank until deployed.
# Web / iOS simulator: http://localhost:8000
# Android emulator: handled automatically (localhost -> 10.0.2.2)
# Physical device: this machine's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_PREDICTION_API_URL=http://localhost:8000
